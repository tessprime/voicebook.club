{
  "lexicon": 1,
  "id": "club.voicebook.recording",
  "defs": {
    "main": {
      "type": "record",
      "description": "A voice-practice recording: the reader's audio of one passage of a work.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["createdAt", "work", "audio"],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "When the practice happened. Practice days are derived from this."
          },
          "work": {
            "type": "string",
            "maxLength": 3000,
            "maxGraphemes": 300,
            "description": "Title of the book or work being read."
          },
          "chapter": {
            "type": "string",
            "maxLength": 640,
            "maxGraphemes": 64,
            "description": "Chapter or passage identifier within the work."
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0,
            "description": "Length of the audio in milliseconds, if known."
          },
          "notes": {
            "type": "string",
            "maxLength": 30000,
            "maxGraphemes": 3000,
            "description": "Freeform notes about the practice session."
          },
          "transcript": {
            "type": "ref",
            "ref": "#transcript",
            "description": "What was read, as text: transcribed by a speech-to-text service the reader chose, and possibly edited by them."
          },
          "audio": {
            "type": "blob",
            "accept": ["audio/*"],
            "maxSize": 100000000
          }
        }
      }
    },
    "transcript": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 200000,
          "maxGraphemes": 100000,
          "description": "The transcript."
        },
        "model": {
          "type": "string",
          "maxLength": 640,
          "maxGraphemes": 64,
          "description": "The speech-to-text model that produced it, if known (e.g. whisper-1)."
        },
        "edited": {
          "type": "boolean",
          "description": "Whether the reader changed the text after it was transcribed."
        },
        "words": {
          "type": "array",
          "maxLength": 50000,
          "items": { "type": "ref", "ref": "#timedWord" },
          "description": "When each word was spoken, as transcribed (before any edits to text)."
        }
      }
    },
    "timedWord": {
      "type": "object",
      "required": ["text", "startMs", "endMs"],
      "properties": {
        "text": { "type": "string", "maxLength": 640, "maxGraphemes": 64 },
        "startMs": { "type": "integer", "minimum": 0 },
        "endMs": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
